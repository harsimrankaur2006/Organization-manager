NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://neondb_owner:npg_gRbd71JPBckh@ep-sparkling-credit-b5cbf0nm.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string_of_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
